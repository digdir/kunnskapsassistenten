# ── Backend ───────────────────────────────────────────────────────────────
# Pick one. Keys are per environment: a key minted against a local backend
# will not authenticate against a deployed one.
#
#   https://test.rag.digdir.cloud         headless-rag, deployed test (needs a key)
#   http://localhost:8099                 headless-rag, local (see docs/local-backend.md)
#   https://api.genki-test.digdir.cloud   genki, deployed test (needs a service key)
#   http://localhost:8080                 genki, local
DIGDIR_API_BASE=https://test.rag.digdir.cloud

# Server-side only. It must never reach the browser.
DIGDIR_API_KEY=rag_...

# ── Pinned server-side on purpose; the browser cannot override these ──────
DIGDIR_TOOL=builtin.agent-rag-agent__agent-rag-graph-bundled
DIGDIR_TENANT=public-sector-knowledge
DIGDIR_DATASET_CONFIG_KEY=default
DIGDIR_AGENT_ID=builtin/agent-rag-agent

# genki names tools <service>__<variant> and conversations by service, and maps
# the tenant and dataset key above to its Kudos dataset. Against genki, use:
# DIGDIR_TOOL=kunnskapsassistenten__default
# DIGDIR_AGENT_ID=kunnskapsassistenten

# ── Typesense: optional, read-only ────────────────────────────────────────
# Fills the filter panel and the source excerpts, both of which the backend
# does not expose over HTTP (docs/contract-gaps.md, gaps 1 and 5). Leave these
# unset and the app still runs; the filter row hides and cards show no excerpt.
TYPESENSE_API_HOST=
TYPESENSE_API_KEY_ADMIN=
KUDOS_DOCS_COLLECTION=

# The filter fields for each dataset, as "dataset=id:field[:valueType[:label]]|…"
# with id documentType, organisation or year. A year needs "integer", or the
# backend finds nothing. Unset: no filter panel. Same grammar as the client's
# VITE_KA_FILTER_FIELDS, e.g.
# kudos-full=documentType:type|organisation:orgs_long|year:concerned_years:integer
KA_FILTER_FIELDS=

# The dataset's name and description for the client, as "dataset=Name|description",
# e.g. kudos-full=Kudos|10 064 dokumenter fra kudos.dfo.no
KA_DATASETS=

# Where "Åpne" on a source points.
KUDOS_BASE=https://kudos.dfo.no

# ── Innlogging (Entra ID) ─────────────────────────────────────────────────
# Leave AZURE_CLIENT_ID empty and the server runs with an unsigned development
# identity where anyone can be anyone. It logs which mode it is in on boot.
# Set all three and /api/* requires a signed-in user. See deploy/README.md.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8787/auth/callback

# Required when the three above are set. 32+ chars: openssl rand -hex 32
SESSION_SECRET=

# ── Innlogging (Ansattporten) ─────────────────────────────────────────────
# Only with AUTH_MODE=ansattporten, against genki. The person signs in here, and
# their access token goes to genki as a bearer token (with GenAI-Acting-For when
# they chose among several organisations) instead of DIGDIR_API_KEY and
# X-User-Id. The tokens stay in this server. DIGDIR_API_KEY may then be empty;
# it is only used to probe filters (set KA_CAPABILITIES instead).
# A confidential client, client_secret_basic. genki-test:
# ANSATTPORTEN_ISSUER=https://test.ansattporten.no
# ANSATTPORTEN_CLIENT_ID=
# ANSATTPORTEN_CLIENT_SECRET=
# ANSATTPORTEN_REDIRECT_URI=http://localhost:8787/auth/callback
# ANSATTPORTEN_AUDIENCE=digdir:genai
# ANSATTPORTEN_ALTINN_RESOURCE=urn:altinn:resource:digdir-genai-platform-test

# ── Hvilken innlogging ────────────────────────────────────────────────────
# entra | ansattporten | off. Utelatt: entra hvis Azure-variablene over er
# satt, ellers off. Ansattporten må velges. SESSION_SECRET trengs for begge.
# AUTH_MODE=entra

# ── Overrides ─────────────────────────────────────────────────────────────
# The server measures what the backend supports at boot. Force it instead
# with a space-separated list, e.g. "filters" or "no-filters".
# KA_CAPABILITIES=

# ── The client ────────────────────────────────────────────────────────────
# The build of apps/web the BFF serves. Left out, it serves only the API.
# WEB_ROOT=../web/dist

# ── The next client (decisions/0013) ──────────────────────────────────────
# KA_NEXT=1 offers apps/web-next beside apps/web, chosen per browser with
# «Prøv ny versjon». Off when left out. WEB_NEXT_ROOT is its build.
# KA_NEXT=1
# WEB_NEXT_ROOT=../web-next/dist
# KA_NEXT_MODEL=kunnskapsassistenten__default
# KA_NEXT_TENANT=digdir

# ── Testers (decisions/0015) ──────────────────────────────────────────────
# User ids as /api/v2/me gives them in userId, separated by commas or spaces.
# Their calls to genki carry GenAI-Environment: KA_TEST_ENVIRONMENT (default
# test), and the chat shows «Testmiljø». Everyone else gets genki's prod.
# Empty or left out: nobody is a tester.
# KA_TESTERS=
# KA_TEST_ENVIRONMENT=test

# ── Excerpt trial (decisions/0016) ────────────────────────────────────────
# The genki environment of the service that cites by excerpt. Set, the app
# offers «Fotnoter som viser til utdraget» under Innstillinger, and the calls
# of a person who turns it on carry GenAI-Environment: KA_EXCERPT_ENVIRONMENT.
# Testers keep KA_TEST_ENVIRONMENT. Empty or left out: no trial.
# KA_EXCERPT_ENVIRONMENT=

PORT=8787

# Where the server listens. Left out: only 127.0.0.1 while sign-in is off,
# every interface with sign-in on. 0.0.0.0 inside a container.
# LISTEN_HOST=

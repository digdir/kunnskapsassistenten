# ── genki ─────────────────────────────────────────────────────────────────
#   https://api.genki-test.digdir.cloud   deployed test (needs a service key)
#   http://localhost:8080                 genki on this machine
DIGDIR_API_BASE=https://api.genki-test.digdir.cloud

# The service key for kunnskapsassistenten, from «API-nøkler for tjenesten» in genki's portal.
# Server-side only. It must never reach the browser. Not used with AUTH_MODE=ansattporten.
DIGDIR_API_KEY=

# ── The client ────────────────────────────────────────────────────────────
# The genki service and variant the client asks, <service>__<variant>, and the tenant whose
# collections it reads. These are the defaults.
# KA_NEXT_MODEL=kunnskapsassistenten__default
# KA_NEXT_TENANT=digdir

# The client's build, which the server serves at every page address. Left out, it serves only
# the API, as for `npm run dev`. `npm run web` sets it.
# WEB_NEXT_ROOT=../web-next/dist

# A layout from genki's builder («Kopier oppsettet»), as JSON or the path of a file holding it
# (decisions/0017). Left out, the client draws KA's own.
# KA_NEXT_LAYOUT=

# ── Sign-in ───────────────────────────────────────────────────────────────
# entra | ansattporten | off. Left out: entra if the Azure variables below are set, otherwise
# off, which is for this machine only: an unsigned id, anyone can be anyone. The server says at
# startup which mode it runs in. SESSION_SECRET is needed for both entra and ansattporten.
AUTH_MODE=off
APP_ORIGIN=http://localhost:8787

# 32+ characters: openssl rand -hex 32
# SESSION_SECRET=

# Entra ID. With these three set and AUTH_MODE left out, the API requires a signed-in user.
# See deploy/README.md.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI=http://localhost:8787/auth/callback

# Ansattporten, against genki. The person signs in here, and their access token goes to genki
# as a bearer token (with GenAI-Acting-For when they chose among several organisations) instead
# of DIGDIR_API_KEY. The tokens stay in this server. A confidential client,
# client_secret_basic. genki-test:
# ANSATTPORTEN_ISSUER=https://test.ansattporten.no
# ANSATTPORTEN_CLIENT_ID=
# ANSATTPORTEN_CLIENT_SECRET=
# ANSATTPORTEN_REDIRECT_URI=http://localhost:8787/auth/callback
# ANSATTPORTEN_AUDIENCE=digdir:genai
# ANSATTPORTEN_ALTINN_RESOURCE=urn:altinn:resource:digdir-genai-platform-test

# ── Testers (decisions/0015) ──────────────────────────────────────────────
# User ids as /api/next/me gives them in userId, separated by commas or spaces. Their calls to
# genki carry GenAI-Environment: KA_TEST_ENVIRONMENT (default test). Everyone else gets genki's
# prod. Empty or left out: nobody is a tester.
# KA_TESTERS=
# KA_TEST_ENVIRONMENT=test

PORT=8787

# Where the server listens. Left out: only 127.0.0.1 while sign-in is off, every interface with
# sign-in on. 0.0.0.0 inside a container.
# LISTEN_HOST=

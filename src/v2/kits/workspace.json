{
  "id": "workspace",
  "name": {
    "nb": "Arbeidsflate",
    "en": "Workspace"
  },
  "purpose": "Longer work over many questions, with projects, notes and documents.",
  "fits": "Services that search datasets, for analysts and caseworkers.",
  "fitsNeeds": ["service:datasets|documents"],
  "layout": {
    "primary": ["projects", "threads"],
    "main": ["chat", "approach", "footnotes"],
    "secondary": ["sources", "notes", "document-view"]
  },
  "components": {
    "chat": {
      "core": true
    },
    "threads": {
      "core": true
    },
    "sources": {
      "core": true
    },
    "footnotes": {
      "core": true
    },
    "projects": {
      "core": false,
      "default": "on",
      "needs": ["genki:projects"]
    },
    "notes": {
      "core": false,
      "default": "on",
      "needs": []
    },
    "document-view": {
      "core": false,
      "default": "on",
      "needs": ["component:sources"]
    },
    "approach": {
      "core": false,
      "default": "on",
      "needs": ["service:steps"]
    },
    "filter": {
      "core": false,
      "default": "on",
      "needs": ["service:filter-fields", "channel:facets"]
    },
    "feedback": {
      "core": false,
      "default": "on",
      "needs": ["channel:feedback"]
    },
    "attachments": {
      "core": false,
      "default": "off",
      "needs": ["service:documents"]
    },
    "variant-picker": {
      "core": false,
      "default": "auto",
      "needs": ["service:variants"]
    }
  },
  "blocks": ["intro"],
  "brand": ["colour", "name", "logo", "intro", "example-questions"]
}
